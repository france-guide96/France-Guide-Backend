{
    "collectionName": "components_tour_details_content_blocks",
    "info": {
        "displayName": "ContentBlock"
    },
    "options": {},
    "attributes": {
        "title": {
            "type": "string"
        },
        "description": {
            "type": "text"
        },
        "isNewDesign": {
            "type": "boolean",
            "required": false,
            "default": false
        },
        "newDesignImageCarousel": {
            "type": "media",
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "isNewDesign"
                        },
                        true
                    ]
                }
            },
            "multiple": true,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        }
    },
    "config": {}
}
